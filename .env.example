# Copy to .env and fill in. Used ONLY by the offline labelling step.
# The classify pipeline must never read this -- see hard rule 3.
#
# Put real keys in .env (gitignored), NEVER in this file -- this one is
# committed.

# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Strong model, single pass over the pool.
LABELLER_MODEL=anthropic/claude-sonnet-4.5
